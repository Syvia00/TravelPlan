@implements IDisposable
@inject PlanItemsApiClient PlanItemsApi

@if (_hasContent)
{
    <p class="eyebrow">NEXT UP</p>
    <p class="big-num countdown">@_label</p>
}

@code {
    /// <summary>How often the display re-derives itself. In-memory only (see RecomputeLabel) — the
    /// API is never called from the tick, only from RefreshAsync (initial load and whenever Trips
    /// actually changes), so a short interval costs nothing extra.</summary>
    private static readonly TimeSpan TickInterval = TimeSpan.FromSeconds(30);

    [Parameter]
    public IReadOnlyList<TripDto> Trips { get; set; } = Array.Empty<TripDto>();

    [Parameter]
    public bool TripsLoading { get; set; }

    private Timer? _timer;
    private bool _disposed;
    private bool _hasContent;
    private string _label = string.Empty;

    // The fetched plan items for whichever trip is currently active, and which trip they're for —
    // RecomputeLabel reads these instead of calling the API. Edits made elsewhere while this page
    // stays open (the calendar's DayView, or another device) only show here after a reload, since
    // nothing currently tells this component a plan item changed without a Trips-parameter change.
    private List<PlanItemDto>? _activeTripPlanItems;
    private int? _activeTripPlanItemsTripId;
    private IReadOnlyList<TripDto>? _lastTrips;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _timer = new Timer(OnTick, null, TickInterval, TickInterval);
    }

    protected override async Task OnParametersSetAsync()
    {
        // OnParametersSetAsync fires on every parent re-render, not just when Trips actually
        // changes (e.g. Home's mobile-tab switch passes the same list reference down again) — only
        // refetch when it's genuinely a new list.
        if (!TripsLoading && !ReferenceEquals(Trips, _lastTrips))
        {
            await RefreshAsync();
        }
    }

    private void OnTick(object? state)
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                RecomputeLabel();
                StateHasChanged();
            }
        });
    }

    /// <summary>Fetches plan items for the active trip (if any) and recomputes the label. The only
    /// place that calls the API — initial load and a real Trips change, never the tick.</summary>
    private async Task RefreshAsync()
    {
        _lastTrips = Trips;

        var today = DateOnly.FromDateTime(DateTime.Now);
        var activeTrip = Trips.FirstOrDefault(t => t.StartDate <= today && today <= t.EndDate);

        if (activeTrip is not null)
        {
            try
            {
                _activeTripPlanItems = await PlanItemsApi.ListByTripAsync(activeTrip.Id);
            }
            catch (ApiException)
            {
                _activeTripPlanItems = null; // Best-effort — RecomputeLabel falls through to the day-count summary.
            }

            _activeTripPlanItemsTripId = activeTrip.Id;
        }
        else
        {
            _activeTripPlanItems = null;
            _activeTripPlanItemsTripId = null;
        }

        RecomputeLabel();
    }

    /// <summary>Pure in-memory — never calls the API. Reads Trips and the plan items RefreshAsync
    /// already fetched; this is what the 30-second tick calls.</summary>
    private void RecomputeLabel()
    {
        var now = DateTime.Now;
        var today = DateOnly.FromDateTime(now);

        var activeTrip = Trips.FirstOrDefault(t => t.StartDate <= today && today <= t.EndDate);
        if (activeTrip is not null)
        {
            RecomputeForActiveTrip(activeTrip, now, today);
            return;
        }

        var nextTrip = Trips
            .Where(t => t.StartDate > today)
            .OrderBy(t => t.StartDate)
            .FirstOrDefault();

        if (nextTrip is not null)
        {
            var days = nextTrip.StartDate.DayNumber - today.DayNumber;
            _label = days == 1
                ? $"Tomorrow: {nextTrip.Title}"
                : $"{days} days until {nextTrip.Title}";
            _hasContent = true;
            return;
        }

        _hasContent = false;
        _label = string.Empty;
    }

    private void RecomputeForActiveTrip(TripDto trip, DateTime now, DateOnly today)
    {
        PlanItemDto? nextStop = null;
        if (_activeTripPlanItemsTripId == trip.Id && _activeTripPlanItems is not null)
        {
            nextStop = _activeTripPlanItems
                .Where(i => i.Date is not null && i.Time is not null)
                .Select(i => (Item: i, At: i.Date!.Value.ToDateTime(i.Time!.Value)))
                .Where(x => x.At >= now)
                .OrderBy(x => x.At)
                .Select(x => x.Item)
                .FirstOrDefault();
        }

        if (nextStop is not null)
        {
            var at = nextStop.Date!.Value.ToDateTime(nextStop.Time!.Value);
            _label = $"Next stop in {FormatDuration(at - now)}: {nextStop.Title}";
        }
        else
        {
            var dayNumber = today.DayNumber - trip.StartDate.DayNumber + 1;
            var totalDays = trip.EndDate.DayNumber - trip.StartDate.DayNumber + 1;
            _label = $"Day {dayNumber} of {totalDays} — {trip.Title}";
        }

        _hasContent = true;
    }

    private static string FormatDuration(TimeSpan span)
    {
        if (span.TotalHours >= 1)
        {
            var hours = (int)Math.Round(span.TotalHours);
            return hours <= 1 ? "1 hour" : $"{hours} hours";
        }

        var minutes = Math.Max(1, (int)Math.Round(span.TotalMinutes));
        return minutes <= 1 ? "1 minute" : $"{minutes} minutes";
    }

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
    }
}
