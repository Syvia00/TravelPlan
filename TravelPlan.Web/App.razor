@using TravelPlan.Web.Pages

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @* The authentication callback route and the anonymous share-link landing page must
               render unconditionally, even while logged out — the former is where MSAL redirects
               back to mid-login, the latter is the whole point of a share link (no account
               needed). Both still render inside MainLayout so a signed-in visitor sees the usual
               book chrome; SharedTrip.razor itself decides what an anonymous visitor sees.
               Everything else is gated: authenticated visitors get the open-book shell, everyone
               else gets the closed-book landing page instead of the routed page. *@
            @if (routeData.PageType == typeof(Pages.Authentication))
            {
                <PageTurnHost RouteData="@routeData" />
            }
            else if (routeData.PageType == typeof(Pages.SharedTrip))
            {
                <MainLayout>
                    <PageTurnHost RouteData="@routeData" />
                </MainLayout>
            }
            else
            {
                <AuthorizeView>
                    <Authorized>
                        <MainLayout>
                            <PageTurnHost RouteData="@routeData" />
                        </MainLayout>
                    </Authorized>
                    <NotAuthorized>
                        <Landing />
                    </NotAuthorized>
                    <Authorizing>
                        <div class="boot-loader">
                            <p class="boot-wordmark">TravelPlan</p>
                            <div class="boot-spinner"></div>
                        </div>
                    </Authorizing>
                </AuthorizeView>
            }
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
